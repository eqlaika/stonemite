{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Stonemite · EQ boxing",
  "Version": "0.1.0.0",
  "Author": "Laikasoft",
  "UUID": "co.laikasoft.stonemite",
  "Description": "Live Stonemite character switching and broadcast control.",
  "Category": "Stonemite · EQ boxing",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/icon",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.4"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "Character",
      "UUID": "co.laikasoft.stonemite.character",
      "Icon": "imgs/actions/stonemite/icon",
      "Tooltip": "Activate one configured Stonemite box, or select it while Swap is armed.",
      "PropertyInspectorPath": "ui/box.html",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/actions/stonemite/key", "ShowTitle": false }]
    },
    {
      "Name": "Character slot 1",
      "UUID": "co.laikasoft.stonemite.character-slot-1",
      "VisibleInActionsList": false,
      "Icon": "imgs/actions/stonemite/icon",
      "Tooltip": "Activate the character in Stonemite slot 1, or select it while Swap is armed.",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/actions/stonemite/key", "ShowTitle": false }]
    },
    {
