      "PropertyInspectorPath": "ui/box.html",
      "Controllers": ["Encoder"],
      "Encoder": {
        "Icon": "imgs/actions/stonemite/key",
        "StackColor": "#59d8d0",
        "layout": "layouts/xtarget-v4.json",
        "TriggerDescription": {
          "Rotate": "Select Extended Target",
          "Push": "Consider target",
          "Touch": "Activate box"
        }
      },
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/actions/stonemite/key", "ShowTitle": false }]
