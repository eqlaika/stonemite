{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stonemite",
  "version": "2026.8.2200",
  "identifier": "co.laikasoft.stonemite",
  "build": {
    "beforeBuildCommand": "npm --prefix ../../packages/desktop run build",
    "frontendDist": "../../packages/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stonemite Settings",
        "width": 900,
        "height": 660,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "fullscreen": false,
        "decorations": true,
        "shadow": true,
        "theme": null,
        "backgroundColor": "#f3f5f7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Laikasoft",
    "icon": ["assets/app.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
