{
  "name": "ikkinz",
  "version": "0.1.0",
  "private": true,
  "description": "Stonemite control surface for Stream Deck",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "build": "npm run assets && rollup -c",
    "watch": "npm run assets && rollup -c -w --watch.onEnd=\"streamdeck restart com.laikasoft.ikkinz\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests scripts --max-warnings=0",
    "pretypecheck": "npm run assets",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run assets",
    "test": "vitest run",
    "validate": "npm run build && node scripts/plugin-cli.mjs validate",
    "pack": "npm run validate && node scripts/plugin-cli.mjs pack"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.8.1",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "rollup": "^4.59.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
