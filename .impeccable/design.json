  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The full-width property-inspector action used to pair with Stonemite.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Pair with Stonemite</button>",
      "css": ".ds-btn-primary { display: block; width: 100%; min-height: 34px; border: 1px solid #59d8d0; border-radius: 8px; background: #59d8d0; color: #101615; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 12px; font-weight: 700; cursor: pointer; } .ds-btn-primary:hover:not(:disabled) { background: #78e4de; } .ds-btn-primary:focus-visible { outline: 2px solid #59d8d0; outline-offset: 2px; } .ds-btn-primary:disabled { cursor: wait; opacity: 0.55; }"
    },
    {
      "name": "Labeled Input",
      "kind": "input",
      "refersTo": "input",
      "description": "A compact property-inspector field with explicit help and invalid state.",
      "html": "<label class=\"ds-input-label\" for=\"ds-address\">Stonemite address</label><input class=\"ds-input\" id=\"ds-address\" type=\"text\" value=\"jaggedpine.local:19720\" aria-describedby=\"ds-address-help\"><p class=\"ds-input-help\" id=\"ds-address-help\">Use the address shown by Stonemite, including the port.</p>",
      "css": ".ds-input-label { display: block; margin: 14px 0 6px; color: #f5f7fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 12px; font-weight: 650; } .ds-input { display: block; width: 100%; height: 34px; padding: 6px 9px; border: 1px solid #4a5059; border-radius: 7px; outline: 0; background: #1c1e22; color: #f5f7fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 12px; font-variant-numeric: tabular-nums; caret-color: #59d8d0; } .ds-input:focus-visible { outline: 2px solid #59d8d0; outline-offset: 2px; } .ds-input[aria-invalid='true'] { border-color: #ff826f; } .ds-input:disabled { opacity: 0.55; } .ds-input-help { margin: 5px 0 0; color: #b8c0ca; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 11px; line-height: 1.4; }"
    },
    {
      "name": "Connection Status Panel",
      "kind": "card",
      "refersTo": "status-panel",
      "description": "The property-inspector status header that pairs a colored dot with live title and detail text.",
      "html": "<header class=\"ds-status\" data-state=\"connected\" role=\"status\" aria-live=\"polite\"><span class=\"ds-status-dot\" aria-hidden=\"true\"></span><span><strong class=\"ds-status-title\">Connected</strong><small class=\"ds-status-detail\">jaggedpine.local:19720</small></span></header>",
      "css": ".ds-status { display: grid; grid-template-columns: 10px 1fr; gap: 10px; align-items: center; width: 100%; padding: 12px; border-radius: 12px; background: #30343a; color: #f5f7fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; } .ds-status-dot { width: 9px; height: 9px; border-radius: 50%; background: #b8c0ca; } .ds-status[data-state='connected'] .ds-status-dot { background: #80df89; } .ds-status[data-state='pairing'] .ds-status-dot, .ds-status[data-state='connecting'] .ds-status-dot, .ds-status[data-state='reconnecting'] .ds-status-dot { background: #ffc75c; animation: ds-breathe 1.2s ease-in-out infinite alternate; } .ds-status[data-state='error'] .ds-status-dot { background: #ff826f; } .ds-status-title, .ds-status-detail { display: block; } .ds-status-title { margin-bottom: 2px; font-size: 13px; font-weight: 700; } .ds-status-detail { color: #b8c0ca; font-size: 11px; line-height: 1.4; } @keyframes ds-breathe { to { opacity: 0.35; } } @media (prefers-reduced-motion: reduce) { .ds-status-dot { animation-duration: 1ms !important; } }"
    },
